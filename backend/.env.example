# SHIVMANI HRMS Backend Environment Variables (Example Template)

# Application Settings
APP_NAME=SHIVMANI HRMS
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# SQL Server Database Configuration
DB_HOST=127.0.0.1
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrongPasswordHere!
DB_NAME=hrms_db

# SQLAlchemy Async Connection URL
DATABASE_URL=mssql+aioodbc://sa:YourStrongPasswordHere!@127.0.0.1:1433/hrms_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Security Keys
SECRET_KEY=change-this-to-a-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
